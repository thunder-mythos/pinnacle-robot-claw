{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nL2 = Motor(Ports.PORT9, GearSetting.RATIO_6_1, True)\nL3 = Motor(Ports.PORT10, GearSetting.RATIO_6_1, True)\nR1 = Motor(Ports.PORT1, GearSetting.RATIO_6_1, False)\nLiftL1 = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)\nLiftR1 = Motor(Ports.PORT5, GearSetting.RATIO_18_1, True)\nPneumaticClaw = DigitalOut(brain.three_wire_port.g)\nRearSpinner = Motor(Ports.PORT21, GearSetting.RATIO_18_1, False)\nPneumaticTilt = DigitalOut(brain.three_wire_port.f)\nPneumaticRotate = DigitalOut(brain.three_wire_port.h)\nR2 = Motor(Ports.PORT2, GearSetting.RATIO_6_1, False)\nLiftL2 = Motor(Ports.PORT7, GearSetting.RATIO_18_1, False)\nLiftR2 = Motor(Ports.PORT4, GearSetting.RATIO_18_1, True)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n\nimu = Inertial(Ports.PORT15)\n\n#--------------------------------------------------------------\n# 1. CONSTANTS\n#--------------------------------------------------------------\nDRIVE_MOTORS = [L2, L3, R1, R2]\nLIFT_MOTORS = [LiftL1, LiftL2, LiftR1, LiftR2]\n\nDRIVE_TORQUE = 100\nFN_TORQUE = 50\nFN_VEL_SCALE = 0.35\n\nTURN_MAX = 60.0\nL2_MAX_VEL = 100.0\nL3_MAX_VEL = 100.0\nR1_MAX_VEL = 100.0\nR2_MAX_VEL = 100.0\nDEADBAND = 0.05\nKNEE_STICK = 0.85\nKNEE_VEL = 50.0\n\nAUTON_COEF = 0.65\n\nWHEEL_DIAMETER = 3.25\nDRIVE_GEAR_RATIO = 0.75\nLIFT_DEG_PER_INCH = 64\nLIFT_VEL = 50\n\nSNAP_TOL_DEG = 3.0\nSMOOTH_TAU = 0\n\nclaw_closed = False\ntilt_out = False\nrotate_out = False\nimu_ready = False\nsnap_target = None\n\n#--------------------------------------------------------------\n# 2. HELPERS\n#--------------------------------------------------------------\ndef clamp(x, lo, hi):\n    return lo if x < lo else hi if x > hi else x\n\ndef wrap180(a):\n    while a > 180.0:\n        a -= 360.0\n    while a < -180.0:\n        a += 360.0\n    return a\n\ndef set_drive(left_pct, right_pct):\n    L2.spin(FORWARD, clamp(left_pct, -L2_MAX_VEL, L2_MAX_VEL), PERCENT)\n    L3.spin(FORWARD, clamp(left_pct, -L3_MAX_VEL, L3_MAX_VEL), PERCENT)\n    R1.spin(FORWARD, clamp(right_pct, -R1_MAX_VEL, R1_MAX_VEL), PERCENT)\n    R2.spin(FORWARD, clamp(right_pct, -R2_MAX_VEL, R2_MAX_VEL), PERCENT)\n\ndef stop_drive():\n    for m in DRIVE_MOTORS:\n        m.stop(BRAKE)\n\ndef calibrate_imu():\n    global imu_ready\n    imu.calibrate()\n    while imu.is_calibrating():\n        wait(10, MSEC)\n    imu_ready = True\n\ndef wait_for_imu():\n    while not imu_ready:\n        wait(10, MSEC)\n\ndef imu_turn(deg, vel_pct):\n    target = imu.rotation(DEGREES) + deg\n    while True:\n        err = wrap180(target - imu.rotation(DEGREES))\n        if abs(err) < SNAP_TOL_DEG:\n            break\n        v = vel_pct if abs(err) > 15.0 else 25.0\n        cmd = math.copysign(v, err)\n        set_drive(cmd, -cmd)\n        wait(10, MSEC)\n    stop_drive()\n\n#--------------------------------------------------------------\n# 3. DRIVER\n#--------------------------------------------------------------\ndef drive_map(s):\n    a = abs(s)\n    if a < DEADBAND:\n        return 0.0\n    if a < KNEE_STICK:\n        v = (a / KNEE_STICK) * KNEE_VEL\n    else:\n        v = KNEE_VEL + ((a - KNEE_STICK) / (1.0 - KNEE_STICK)) * (100.0 - KNEE_VEL)\n    return math.copysign(v, s)\n\ndef turn_map(s):\n    a = abs(s)\n    if a < DEADBAND:\n        return 0.0\n    return math.copysign(a * TURN_MAX, s)\n\ndef driver_loop():\n    global snap_target\n    wait_for_imu()\n    fn_was = False\n    left_s = 0.0\n    right_s = 0.0\n    lift_s = 0.0\n    dt = 0.02\n    k = min(1.0, dt / SMOOTH_TAU) if SMOOTH_TAU > 0 else 1.0\n    while True:\n        fn = controller_1.buttonR2.pressing()\n        if fn != fn_was:\n            for m in DRIVE_MOTORS:\n                m.set_max_torque(FN_TORQUE if fn else DRIVE_TORQUE, PERCENT)\n            fn_was = fn\n        if snap_target is not None:\n            imu_turn(snap_target, TURN_MAX)\n            snap_target = None\n            left_s = 0.0\n            right_s = 0.0\n            continue\n        dv = drive_map(controller_1.axis3.position() / 100.0)\n        tv = turn_map(controller_1.axis1.position() / 100.0)\n        if fn:\n            dv *= FN_VEL_SCALE\n            tv *= FN_VEL_SCALE\n        left_s += ((dv + tv) - left_s) * k\n        right_s += ((dv - tv) - right_s) * k\n        if abs(left_s) < 0.5 and abs(right_s) < 0.5:\n            for m in DRIVE_MOTORS:\n                m.stop(BRAKE)\n        else:\n            set_drive(left_s, right_s)\n        if controller_1.buttonL1.pressing():\n            lift_t = LIFT_VEL\n        elif controller_1.buttonL2.pressing():\n            lift_t = -LIFT_VEL\n        else:\n            lift_t = 0.0\n        lift_s += (lift_t - lift_s) * k\n        if lift_t == 0.0 and abs(lift_s) < 1.0:\n            for m in LIFT_MOTORS:\n                m.stop(HOLD)\n        else:\n            for m in LIFT_MOTORS:\n                m.spin(FORWARD, lift_s, PERCENT)\n        if controller_1.buttonR1.pressing():\n            RearSpinner.spin(REVERSE, 100, PERCENT)\n        else:\n            RearSpinner.stop()\n        wait(20, MSEC)\n\ndef on_left():\n    global snap_target\n    if controller_1.buttonR2.pressing():\n        snap_target = -90.0\n\ndef on_right():\n    global snap_target\n    if controller_1.buttonR2.pressing():\n        snap_target = 90.0\n\n#--------------------------------------------------------------\n# 4. MECHANISMS\n#--------------------------------------------------------------\ndef claw_toggle():\n    global claw_closed\n    claw_closed = not claw_closed\n    PneumaticClaw.set(claw_closed)\n\ndef tilt_toggle():\n    global tilt_out\n    tilt_out = not tilt_out\n    PneumaticTilt.set(tilt_out)\n\ndef rotate_toggle():\n    global rotate_out\n    rotate_out = not rotate_out\n    PneumaticRotate.set(rotate_out)\n\ndef lift_inches(inches):\n    deg = inches * LIFT_DEG_PER_INCH\n    for m in LIFT_MOTORS:\n        m.spin_to_position(m.position(DEGREES) + deg, DEGREES, LIFT_VEL, PERCENT, False)\n    for m in LIFT_MOTORS:\n        while m.is_spinning():\n            wait(10, MSEC)\n    for m in LIFT_MOTORS:\n        m.stop(HOLD)\n\n#--------------------------------------------------------------\n# 5. AUTON\n#--------------------------------------------------------------\ndef auton_drive_inches(inches):\n    vel = AUTON_COEF * 100.0\n    if inches < 0:\n        vel = -vel\n    target_deg = abs(inches) / (math.pi * WHEEL_DIAMETER * DRIVE_GEAR_RATIO) * 360.0\n    for m in DRIVE_MOTORS:\n        m.set_position(0, DEGREES)\n    set_drive(vel, vel)\n    while True:\n        avg = sum(m.position(DEGREES) for m in DRIVE_MOTORS) / 4.0\n        if abs(avg) >= target_deg:\n            break\n        wait(10, MSEC)\n    stop_drive()\n\ndef auton_turn_deg(deg):\n    imu_turn(deg, AUTON_COEF * TURN_MAX)\n\ndef run_autonomous():\n    wait_for_imu()\n    claw_toggle()\n    stop_drive()\n\n#--------------------------------------------------------------\n# 6. WHEN STARTED\n#--------------------------------------------------------------\ndef startup():\n    for m in LIFT_MOTORS:\n        m.set_stopping(HOLD)\n        m.set_max_torque(100, PERCENT)\n    for m in DRIVE_MOTORS:\n        m.set_stopping(BRAKE)\n        m.set_max_torque(DRIVE_TORQUE, PERCENT)\n    RearSpinner.set_max_torque(100, PERCENT)\n    calibrate_imu()\n\ndef autonomous():\n    auton_task = Thread(run_autonomous)\n    while comp.is_autonomous() and comp.is_enabled():\n        wait(10, MSEC)\n    auton_task.stop()\n\ndef user_control():\n    driver_task = Thread(driver_loop)\n    while comp.is_driver_control() and comp.is_enabled():\n        wait(10, MSEC)\n    driver_task.stop()\n\ncomp = Competition(user_control, autonomous)\n\ncontroller_1.buttonB.pressed(claw_toggle)\ncontroller_1.buttonY.pressed(tilt_toggle)\ncontroller_1.buttonDown.pressed(rotate_toggle)\ncontroller_1.buttonLeft.pressed(on_left)\ncontroller_1.buttonRight.pressed(on_right)\n\nstartup()\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[9],"name":"L2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[10],"name":"L3","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[1],"name":"R1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[6],"name":"LiftL1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"up","rev":"down","gear":"ratio18_1"},"triportSourcePort":22},{"port":[5],"name":"LiftR1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[7],"name":"PneumaticClaw","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[21],"name":"RearSpinner","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[6],"name":"PneumaticTilt","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[8],"name":"PneumaticRotate","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[2],"name":"R2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[7],"name":"LiftL2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[4],"name":"LiftR2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}